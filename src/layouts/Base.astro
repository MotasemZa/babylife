---
import '../styles/global.css';
import { t, base, altPath, type Lang } from '../lib/i18n';
import site from '../data/site.json';
import SocialRow from '../components/SocialRow.astro';
import JordanSeal from '../components/JordanSeal.astro';
import ranges from '../data/ranges.json';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  ogImage?: string;
}
const { lang, title, description, ogImage = '/images/2026/07/babylife-share-card.png' } = Astro.props;

const path = Astro.url.pathname;
const other = altPath(lang, path);
const b = base(lang);
const tel = site.contact.phone.replace(/[^+\d]/g, '');

const navItems = [
  { href: `${b}/`, label: t(lang, 'home') },
  { href: `${b}/products/`, label: t(lang, 'products') },
  { href: `${b}/about/`, label: t(lang, 'about') },
  { href: `${b}/blog/`, label: t(lang, 'journal') },
  { href: `${b}/careers/`, label: t(lang, 'careers') },
  { href: `${b}/contact/`, label: t(lang, 'contact') },
];
const isCurrent = (href: string) => (href === `${b}/` ? path === `${b}/` || path === b : path.startsWith(href));

const enPath = lang === 'en' ? path : other;
const arPath = lang === 'ar' ? path : other;
---

<!doctype html>
<html lang={lang === 'ar' ? 'ar' : 'en'} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.png" />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(enPath, Astro.site)} />
    <link rel="alternate" hreflang="ar" href={new URL(arPath, Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(path, Astro.site)} />
    <meta property="og:site_name" content="Baby Life" />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_JO' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // Opt in to the reveal animation only once we know we can finish it.
      // Runs in head so the class lands before first paint, otherwise the
      // sections flash in at full opacity and then jump.
      if ('IntersectionObserver' in window) {
        document.documentElement.classList.add('js-reveal');
      }

      // Language routing, before paint so there is no English flash.
      // An explicit choice (the header switcher) always wins and is
      // remembered; with no choice recorded, an Arabic-preferring browser
      // gets the Arabic home page. Home page only — a shared deep link
      // should open exactly where it points.
      (function () {
        try {
          var path = location.pathname;
          var pref = localStorage.getItem('bl-lang');
          if (path === '/' || path === '') {
            if (pref === 'ar') {
              location.replace('/ar/');
            } else if (!pref) {
              var langs = navigator.languages || [navigator.language || ''];
              if (langs.some(function (l) { return /^ar\b/i.test(l); })) {
                location.replace('/ar/');
              }
            }
          } else if ((path === '/ar/' || path === '/ar') && pref === 'en') {
            location.replace('/');
          }
        } catch (e) { /* storage blocked: stay put */ }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Figtree:wght@300..700&family=Tajawal:wght@300;400;500;700;800&display=swap"
    />
  </head>
  <body>
    <div class="jo-stripe" aria-hidden="true"></div>
    <a class="skip" href="#main">{t(lang, 'skip')}</a>

    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href={`${b}/`}>
          <img src="/images/2023/05/Baby-Life-Logo-01.png" alt="Baby Life" width="240" height="92" />
        </a>

        <ul class="nav-menu" id="primary-menu">
          {navItems.map((item) => (
            <li><a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a></li>
          ))}
        </ul>

        <div class="nav-actions">
          <a class:list={['nav-lang', { 'is-latin': lang === 'ar' }]} href={other} hreflang={lang === 'ar' ? 'en' : 'ar'}>
            {lang === 'ar' ? 'English' : 'العربية'}
          </a>
          <a class="btn btn-primary nav-cta" href={`${b}/contact/`}>{t(lang, 'becomeStockist')}</a>
          <button class="nav-toggle" aria-expanded="false" aria-controls="primary-menu" aria-label={t(lang, 'menu')}>&#9776;</button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="f-grid">
          <div>
            <a class="brand" href={`${b}/`}>
              <img src="/images/2023/03/BANNER-033.png" alt="Baby Life" />
            </a>
            <p style="max-width:32ch">{t(lang, 'footerBlurb')}</p>
            <SocialRow />
          </div>

          <div>
            <h4>{t(lang, 'products')}</h4>
            <ul>
              {ranges.map((r) => (
                <li><a href={`${b}/range/${r.slug}/`}>{r.name[lang]}</a></li>
              ))}
            </ul>
          </div>

          <div>
            <h4>{t(lang, 'company')}</h4>
            <ul>
              <li><a href={`${b}/about/`}>{t(lang, 'about')}</a></li>
              <li><a href={`${b}/blog/`}>{t(lang, 'journal')}</a></li>
              <li><a href={`${b}/careers/`}>{t(lang, 'careers')}</a></li>
              <li><a href={`${b}/contact/`}>{t(lang, 'contact')}</a></li>
              <li><a href="/Certificates.aspx">{t(lang, 'certificates')}</a></li>
            </ul>
          </div>

          <div>
            <h4>{t(lang, 'forContact')}</h4>
            <ul>
              <li>{site.contact.address[lang]}</li>
              <li><a href={`tel:${tel}`} dir="ltr">{site.contact.phone}</a></li>
              <li><a href={`mailto:${site.contact.email}`} dir="ltr">{site.contact.email}</a></li>
              <li>{site.contact.hours[lang]}</li>
            </ul>
          </div>
        </div>

        <div class="f-bottom">
          <span>&copy; {new Date().getFullYear()} Baby Life &middot; Khattab Group</span>
          <span class="f-origin">
            <JordanSeal lang={lang} />
            <a href="/Certificates.aspx">{t(lang, 'certificates')}</a>
          </span>
        </div>
      </div>
    </footer>

    <script>
      // Mobile nav toggle
      const toggle = document.querySelector('.nav-toggle');
      const menu = document.getElementById('primary-menu');
      toggle?.addEventListener('click', () => {
        const open = menu?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(!!open));
      });

      // Scroll reveal
      const revealEls = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && revealEls.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' }
        );
        revealEls.forEach((el) => io.observe(el));
      } else {
        revealEls.forEach((el) => el.classList.add('is-in'));
      }

      const noMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Remember an explicit language choice; the head script honours it on
      // the next visit and stops second-guessing the reader.
      document.querySelector('.nav-lang')?.addEventListener('click', function () {
        try {
          localStorage.setItem('bl-lang', this.getAttribute('hreflang') === 'ar' ? 'ar' : 'en');
        } catch (e) {}
      });

      // Compact header once the page is moving.
      const header = document.querySelector('.site-header');
      let hTick = false;
      const onHScroll = () => {
        header?.classList.toggle('is-compact', window.scrollY > 40);
        hTick = false;
      };
      window.addEventListener('scroll', () => {
        if (!hTick) { hTick = true; requestAnimationFrame(onHScroll); }
      }, { passive: true });
      onHScroll();

      // Scroll progress engine: every [data-fx] element gets --p, its own
      // 0..1 journey through the viewport. CSS decides what that means —
      // the fan of packs in the hero reads it, nothing else has to.
      const fxEls = Array.from(document.querySelectorAll('[data-fx]'));
      if (fxEls.length && !noMotion) {
        let fxTick = false;
        const fxUpdate = () => {
          const vh = window.innerHeight;
          for (const el of fxEls) {
            const r = el.getBoundingClientRect();
            const p = Math.min(1, Math.max(0, (vh - r.top) / (vh + r.height)));
            el.style.setProperty('--p', p.toFixed(4));
          }
          fxTick = false;
        };
        window.addEventListener('scroll', () => {
          if (!fxTick) { fxTick = true; requestAnimationFrame(fxUpdate); }
        }, { passive: true });
        fxUpdate();
      }

      // Count-up on the hero figures. The digits animate; any prefix or
      // suffix ("#", "+") stays put, so "#1" never flashes as "#0".
      if (!noMotion) {
        document.querySelectorAll('.hero-stats .n').forEach((el) => {
          const m = (el.textContent || '').match(/^([^\d]*)(\d+)(.*)$/);
          if (!m) return;
          const [, pre, digits, post] = m;
          const target = Number(digits);
          const t0 = performance.now();
          const dur = 900;
          const tick = (now) => {
            const p = Math.min(1, (now - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            el.textContent = pre + String(Math.round(target * eased)) + post;
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }

      // A few degrees of tilt on the cards, following the pointer. Hover
      // devices only — on touch it would just fight the scroll.
      if (!noMotion && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll('.family, .tile, .follow-card').forEach((card) => {
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect();
            const x = (e.clientX - r.left) / r.width - 0.5;
            const y = (e.clientY - r.top) / r.height - 0.5;
            card.style.transform =
              `perspective(700px) rotateX(${(-y * 5).toFixed(2)}deg) rotateY(${(x * 5).toFixed(2)}deg) translateY(-4px)`;
          });
          card.addEventListener('pointerleave', () => {
            card.style.transform = '';
          });
        });
      }
    </script>
  </body>
</html>
